# Example only. Database and user must be created separately.
DATABASE_URL=mysql+pymysql://campus_app:your_password@127.0.0.1:3306/campus_message?charset=utf8mb4

# Generate at least 32 random ASCII characters locally; never commit the real secret.
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
JWT_EXPIRE_HOURS=2

MODEL_PATH=artifacts/models/baseline/pipeline.joblib
# Auto-approve normal predictions with spam probability <= this threshold.
AUTO_APPROVE_SPAM_THRESHOLD=0.25
